# Credenciais do Canvas LMS Afya
TOKEN=seu_token_canvas_aqui
CANVAS_BASE_URL=https://afya.instructure.com
PORT=3000

# Configuração do Modelo de IA para o Chat Web Local
# Opções de AI_PROVIDER: openrouter | gemini | openai | ollama
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-sua_chave_do_openrouter_aqui
# Exemplos de modelos do OpenRouter:
# - google/gemini-2.0-flash-001 (rápido e excelente com function calling)
# - anthropic/claude-3.5-sonnet
# - meta-llama/llama-3.3-70b-instruct
# - deepseek/deepseek-chat
AI_MODEL=google/gemini-2.0-flash-001
# AI_BASE_URL=https://openrouter.ai/api/v1 (preenchido automaticamente quando AI_PROVIDER=openrouter)