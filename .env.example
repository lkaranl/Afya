# Credenciais do Canvas LMS Afya (Uso local / Admin)
TOKEN=seu_token_canvas_aqui
CANVAS_BASE_URL=https://afya.instructure.com
PORT=3000

# Configuração do Modelo de IA para o Agente Pedagógico
# Opções de AI_PROVIDER: openrouter | gemini | openai | ollama
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-sua_chave_aqui
AI_MODEL=google/gemini-2.5-flash-lite
AI_MODEL_SECUNDARY=nex-agi/nex-n2.5-mini:free

# -------------------------------------------------------------------
# CONFIGURAÇÕES COMERCIAIS & TELEGRAM BOT (SaaS Multi-Tenant)
# -------------------------------------------------------------------
# Token gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# IDs de usuários do Telegram com acesso VIP perpétuo e gratuito (separados por vírgula)
# Obtenha seu ID conversando com @userinfobot no Telegram
ADMIN_TELEGRAM_IDS=123456789,987654321

# Limite de requisições de teste gratuito (Trial) antes de solicitar assinatura
TRIAL_MAX_REQUESTS=20

# Quantidade de mensagens mantidas na memória de contexto da conversa (janela deslizante, padrão: 10)
CHAT_HISTORY_LIMIT=10

# Valor da assinatura mensal em centavos (ex: 4900 = R$ 49,00)
SUBSCRIPTION_PRICE_CENTS=4900

# Chave PIX para recebimento das assinaturas no Telegram
PAYMENT_PIX_KEY=financeiro@afyacanvas.com.br

# Banco de Dados SQLite e Criptografia AES-256-GCM dos tokens de professores
DATABASE_PATH=data/afya_bot.db
DATABASE_ENCRYPTION_KEY=coloque_uma_chave_segura_de_32_caracteres_ou_mais_aqui
CANVAS_DEFAULT_BASE_URL=https://afya.instructure.com